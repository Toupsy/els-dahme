# Öffentliche Adresse mit HTTPS. Caddy holt dafür automatisch ein Zertifikat.
PUBLIC_ORIGIN=https://els.example.de
# Zufälliger Schlüssel, mindestens 32 Zeichen: openssl rand -hex 32
SESSION_SECRET=
# Hash des Passcodes, erzeugt mit: pnpm hash-passcode
PASSCODE_HASH=
# Gültigkeit einer Anmeldung in Stunden (danach erneut Passcode, sobald Netz da ist).
SESSION_TTL_HOURS=24
# Fehlversuche je IP und Zeitfenster, danach 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Hinter Caddy: echte Client-IP für das Rate-Limit verwenden.
TRUST_PROXY=true
LOG_LEVEL=info
# Wachplan-Generator anbinden (docs/betrieb.md): Adresse und Schlüssel aus
# Einstellungen → ELS-Anbindung. Leer lassen, wenn der Wachplan als Datei eingelesen wird.
WACHPLAN_URL=
WACHPLAN_KEY=
# Gemeinsame Konto-Anmeldung auf /, ELS auf /els/. Benötigt die drei Wachplan-Werte.
PORTAL_ENABLED=false
WACHPLAN_PUBLIC_URL=
