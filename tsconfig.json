{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@mode": ["./apps/web/src/mode/live.tsx"]
    }
  },
  "include": ["apps", "packages", "e2e", "worker", "*.ts"],
  "exclude": ["**/dist", "**/node_modules"]
}
