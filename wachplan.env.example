# Wachplan-Generator im Verbund mit dem ELS (docker-compose.wachplan.yml)
#   cp wachplan.env.example wachplan.env
# Zufallswerte: openssl rand -hex 32
# Beim Umzug eines bestehenden Wachplans dieselben Werte wie bisher eintragen, sonst sind die Pläne unlesbar.
MASTER_SECRET=
SALT=
SESSION_SECRET=
NODE_ENV=production
TRUST_PROXY=1
# Leer: Verwaltung im Wachplan selbst (nur für Admin-Konten). Ein eigener Admin-Port wäre von außen nicht erreichbar.
ADMIN_PORT=
# Erstes Admin-Konto, nur wenn noch keins existiert
ADMIN_USERNAME=
ADMIN_PASSWORD=
REGISTRATION_MODE=disabled
